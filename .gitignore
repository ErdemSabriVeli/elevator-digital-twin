# ---------------------------------------------------------------------------
# Godot 4
# ---------------------------------------------------------------------------
# Import / cache folder - Godot regenerates it when the project is opened.
godot/.godot/

# Export output
export/
export_presets.cfg
*.pck
*.zip

# NOTE: *.uid files are NOT ignored. Godot 4.4+ keeps script identities in
# them; leave them out of the repo and dependencies break for whoever clones it.

# ---------------------------------------------------------------------------
# CODESYS
# ---------------------------------------------------------------------------
# The ST source is kept in this repo as plain text (codesys/*.st).
# If you build the CODESYS project yourself, keep its outputs out:
*.project~
*.project.~u
backup/

# ---------------------------------------------------------------------------
# Operating system / editor
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
